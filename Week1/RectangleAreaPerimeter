import java.util.Scanner;
public class RectangleAreaPerimeter {
    public static void main(String[] args){
        Scanner rectanglelength = new Scanner(System.In);
        System.out.print("Input the Rectangle's Length: ");
        int RectangleLength = rectanglelength.nextline();
        Scanner rectangleheight = new Scanner(System.in);
        System.out.print("Input the Rectangle's Height:");
        int RectangleHeight = rectangleheight.nextline();
        System.out.println("The Rectangle's Area is: "+ (RectangleHeight * RectangleLength) + ".");
        System.out.println("The Rectangle's Perimeter is: "+(2*(RectangleHeight + RectangleLength))+".")
        rectangleheight.close();
        rectanglelength.close();
    }
}